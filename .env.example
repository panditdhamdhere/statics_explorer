# Official public endpoint, documented at:
# https://docs.robinhood.com/chain/connecting/
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional. WalletConnect Cloud project ID (https://cloud.walletconnect.com).
# When set, Connect wallet includes WalletConnect in addition to injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
